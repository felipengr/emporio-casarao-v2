# Feed do Instagram na seção Galeria (via behold.so).
# 1. Crie uma conta em https://behold.so e conecte a conta do Instagram do Empório Casarão.
# 2. Crie um feed no painel da Behold e copie o ID que aparece na URL do feed
#    (https://feeds.behold.so/SEU_FEED_ID).
# 3. Cole o ID abaixo. Sem essa variável, a Galeria usa as fotos estáticas de fallback.
BEHOLD_FEED_ID=

# Clube Casarão — mesmo projeto Supabase usado pelo app e pelo painel admin
# (Supabase > Project Settings > API). A chave publicável é segura em código de cliente.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Final da URL da Edge Function de login por CPF (Edge Functions > login-cpf no painel do Supabase)
SUPABASE_FUNCAO_LOGIN=login-cpf
